{
  "expo": {
    "name": "Sage Cinema",
    "slug": "sage-cinema",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sagecinema",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.phcodesage.sagecinema",
      "adaptiveIcon": {
        "backgroundColor": "#080a12",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phcodesage.sagecinema"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080a12",
          "image": "./assets/icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}
